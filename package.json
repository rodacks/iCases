{
  "name": "icases",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run db:generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "node scripts/prisma.mjs push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts prisma/seed.ts *.ts *.json *.mjs README.md"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.8.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
