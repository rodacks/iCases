DATABASE_URL="file:./dev.db"
UPLOAD_DIR="./storage/uploads"
# Local: local. En Vercel: vercel-blob (store de acceso PRIVATE).
ASSET_STORAGE="local"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# En Vercel DATABASE_URL debe ser postgresql://... (p. ej. Neon).
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
COOKIE_SECURE="false"
# Solo si usas un proxy o despliegue HTTPS: origen externo exacto, sin barra final.
# APP_ORIGIN="https://icases.example"
